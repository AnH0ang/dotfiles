{
  "general": {
    "vimMode": true
  },
  "hooks": {
    "AfterAgent": [
      {
        "hooks": [
          {
            "command": "workmux set-window-status done",
            "type": "command"
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "hooks": [
          {
            "command": "workmux set-window-status working",
            "type": "command"
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "command": "workmux set-window-status working",
            "type": "command"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "command": "workmux set-window-status waiting",
            "type": "command"
          }
        ],
        "matcher": "ToolPermission"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "workmux set-window-status done",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "workmux register-agent",
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": {
    "name": "gemini-3.8-flash"
  },
  "security": {
    "auth": {
      "selectedType": "oauth-personal"
    }
  },
  "ui": {
    "autoThemeSwitching": false,
    "theme": "Default Light"
  }
}
