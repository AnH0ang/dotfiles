[core]
    ignorecase = false

[include]
    path = aliases

[commit]
    verbose = true

[rerere]
    enabled = true
    autoupdate = true

[branch]
    autosetuprebase = always
    sort = -committerdate

[log]
    date = relative # show relative date
    follow = true   # follow file renames

[tag]
    sort = -version:refname

[merge]
    autoStash = true
    conflictstyle = diff3

[pretty]
    stash = format:%C(bold magenta)%gd %C(blue)%>(13,trunc)%ad %C(reset)%s

[pull]
    rebase = true
    ff = only

[push]
    autoSetupRemote = true
    followTags = true
    default = simple

[rebase]
    autoStash = true

[fetch]
    prune = true
    pruneTags = true
    all = true

[diff]
    algorithm = histogram
    colorMoved = plain
    mnemonicPrefix = true
    renames = true

[help]
    autocorrect = prompt

[color]
    ui = true

